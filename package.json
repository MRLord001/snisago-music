{
  "name": "snisago-music",
  "version": "1.0.0",
  "description": "Десктопный музыкальный плеер Snisago Music на Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win -p never"
  },
  "keywords": [
    "music",
    "player",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.snisago.music",
    "productName": "Snisago Music",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "discord-rpc": "^4.0.1",
    "soundcloud-scraper": "^5.0.3",
    "youtube-ext": "^1.1.25",
    "yt-dlp-wrap": "^2.3.12"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^24.13.3"
  }
}